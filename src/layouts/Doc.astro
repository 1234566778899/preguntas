---
import "../styles/global.css";
import { appStoreUrl, playStoreUrl } from "../lib/links";

// Páginas de texto: privacidad y soporte. Existen porque App Store Connect exige
// una URL pública para cada una y no acepta un `mailto:`. Nada de JavaScript:
// tienen que abrir y leerse aunque el juego esté caído.
interface Props {
  title: string;
  description: string;
  updated?: string;
}

const { title, description, updated } = Astro.props;
const fullTitle = `${title} — Anónimas`;
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0YR1B1R287"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0YR1B1R287');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FBF7F2" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
  </head>

  <body class="doc">
    <main>
      <a class="back sticker press" href="/">← Volver al juego</a>

      <h1>{title}</h1>
      {updated && <p class="eyebrow updated">Última actualización: {updated}</p>}

      <slot />

      <footer>
        <nav>
          <a href="/privacidad">Privacidad</a>
          <a href="/soporte">Soporte</a>
          <a href="/">Jugar</a>
          <a href={appStoreUrl} target="_blank" rel="noopener">App Store</a>
          <a href={playStoreUrl} target="_blank" rel="noopener">Google Play</a>
        </nav>
        <p class="muted">© 2026 Carlos Jesús Ordaz Hoyos</p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  /* El juego bloquea el scroll del body porque ocupa la pantalla entera.
     Aquí hace falta lo contrario: texto largo que se lee de arriba abajo. */
  body.doc {
    display: block;
    place-items: initial;
    overflow-y: auto;
    height: auto;
    min-height: 100%;
    background: var(--cream);
  }

  body.doc main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 24px 24px 64px;
    font-weight: 500;
    line-height: 1.6;
  }

  body.doc .back {
    --lift: 3px;
    display: inline-block;
    margin-bottom: 28px;
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--text);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  body.doc h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(30px, 7vw, 40px);
    line-height: 1.15;
  }

  body.doc .updated {
    margin-top: 10px;
  }

  body.doc h2 {
    font-size: 22px;
    font-weight: 900;
    margin: 40px 0 12px;
  }

  body.doc h3 {
    font-size: 17px;
    font-weight: 900;
    margin: 24px 0 8px;
  }

  body.doc p,
  body.doc li {
    color: var(--text-2);
    font-size: 16px;
  }

  body.doc p + p {
    margin-top: 12px;
  }

  body.doc ul {
    margin: 12px 0 0 20px;
    display: grid;
    gap: 10px;
  }

  body.doc strong {
    color: var(--text);
    font-weight: 800;
  }

  body.doc a {
    color: var(--text);
  }

  /* Las tarjetas de estas páginas son pegatinas, como en el juego. */
  body.doc .card {
    padding: 22px;
    margin-top: 20px;
    border-radius: 22px;
    background: var(--paper);
    border: var(--stroke) solid var(--ink);
    box-shadow: var(--lift) var(--lift) 0 var(--ink);
  }

  body.doc .card > :first-child {
    margin-top: 0;
  }

  body.doc footer {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1.5px solid var(--divider);
  }

  body.doc footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 14px;
  }

  body.doc footer nav a {
    font-size: 15px;
    font-weight: 800;
  }

  body.doc footer p {
    font-size: 13px;
  }
</style>
