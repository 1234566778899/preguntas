---
import Game from "../components/Game.svelte";
import { appStoreId } from "../lib/links";
import "../styles/global.css";

const title = "Anónimas — preguntas anónimas entre amigos";
const description =
  "Juego de preguntas anónimas para jugar entre amigos. Cada uno escribe una pregunta, todos las responden y al final se revela todo. Sin cuentas, sin registro.";

// El juego se comparte por enlace, así que la tarjeta de previsualización
// importa tanto como la portada. `Astro.site` sale de astro.config.mjs.
const ogImage = new URL("/og.png", Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0YR1B1R287"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0YR1B1R287');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0813" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/og.png" />

    <!-- Safari en iPhone enseña arriba una banda con "Ver" que lleva a la ficha. -->
    <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Se juega a pantalla completa desde la pantalla de inicio del móvil. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Anónimas" />
  </head>
  <body>
    <!-- Todo el juego es una isla: es interactivo y en tiempo real de principio a fin. -->
    <Game client:only="svelte" />
  </body>
</html>
